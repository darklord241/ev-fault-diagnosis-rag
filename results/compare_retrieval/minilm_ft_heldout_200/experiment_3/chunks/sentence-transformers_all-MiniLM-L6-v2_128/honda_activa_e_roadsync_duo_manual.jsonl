{"chunk_id": "honda_activa_e_roadsync_duo_manual_page_4_chunk_0_chunk_0", "record_id": "honda_activa_e_roadsync_duo_manual_page_4_chunk_0", "source_document": "honda_activa_e_roadsync_duo_manual", "source_type": "official", "content_type": "pdf", "title": "honda_activa_e_roadsync_duo_manual", "text": "Navigation System ① ③ ② ④ ① Map Displays the map of current location. ② Navigation Press ▼ of 4-way key switch to set destination or display a navigation route. Setting the navigation route: ③ Explore mode Press ▲ of 4-way key switch to change the map display area.: ④ Scaling • Press ◀ of 4-way key switch to zoom out the map. • Press ▶ of 4-way key switch to zoom in the map. 3", "provenance": {"document_id": "honda_activa_e_roadsync_duo_manual", "url": "https://edge.sitecorecloud.io/hondamotorc388f-hmsi8ece-prodb777-e813/media/Project/HONDA2WI/honda2wheelersindia/pdf/EV/ACTIVA-e/2025/February-Roadsync/activa-e-roadsync-duo-manual.pdf", "source_type": "official", "document_type": "connectivity_manual", "manufacturer": "Honda Motorcycle and Scooter India", "vehicle_model": null, "retrieved_at": "2026-11-22T15:25:22.418285+00:00"}, "metadata": {"category": null, "group": null, "page": 4}}
{"chunk_id": "honda_activa_e_roadsync_duo_manual_page_5_chunk_0_chunk_0", "record_id": "honda_activa_e_roadsync_duo_manual_page_5_chunk_0", "source_document": "honda_activa_e_roadsync_duo_manual", "source_type": "official", "content_type": "pdf", "title": "honda_activa_e_roadsync_duo_manual", "text": "Explore Mode Press 4-way key switch to move the map display area. Press ✓ switch to close the explore mode and back to current location display. Press “Menu up” switch to zoom in the map and Press “Menu down” switch to zoom out the map. 4", "provenance": {"document_id": "honda_activa_e_roadsync_duo_manual", "url": "https://edge.sitecorecloud.io/hondamotorc388f-hmsi8ece-prodb777-e813/media/Project/HONDA2WI/honda2wheelersindia/pdf/EV/ACTIVA-e/2025/February-Roadsync/activa-e-roadsync-duo-manual.pdf", "source_type": "official", "document_type": "connectivity_manual", "manufacturer": "Honda Motorcycle and Scooter India", "vehicle_model": null, "retrieved_at": "2026-11-22T15:25:22.418285+00:00"}, "metadata": {"category": null, "group": null, "page": 5}}
{"chunk_id": "honda_activa_e_roadsync_duo_manual_page_7_chunk_0_chunk_0", "record_id": "honda_activa_e_roadsync_duo_manual_page_7_chunk_0", "source_document": "honda_activa_e_roadsync_duo_manual", "source_type": "official", "content_type": "pdf", "title": "honda_activa_e_roadsync_duo_manual", "text": "➢ Select “Recent” to choose your destination (15 most recent destinations). ➢ Select “e:swap” to choose your destination from up to 15 nearby e:swap (within a 100 km radius). ③ Choose the route from 2 route. 6", "provenance": {"document_id": "honda_activa_e_roadsync_duo_manual", "url": "https://edge.sitecorecloud.io/hondamotorc388f-hmsi8ece-prodb777-e813/media/Project/HONDA2WI/honda2wheelersindia/pdf/EV/ACTIVA-e/2025/February-Roadsync/activa-e-roadsync-duo-manual.pdf", "source_type": "official", "document_type": "connectivity_manual", "manufacturer": "Honda Motorcycle and Scooter India", "vehicle_model": null, "retrieved_at": "2026-11-22T15:25:22.418285+00:00"}, "metadata": {"category": null, "group": null, "page": 7}}
{"chunk_id": "honda_activa_e_roadsync_duo_manual_page_9_chunk_0_chunk_0", "record_id": "honda_activa_e_roadsync_duo_manual_page_9_chunk_0", "source_document": "honda_activa_e_roadsync_duo_manual", "source_type": "official", "content_type": "pdf", "title": "honda_activa_e_roadsync_duo_manual", "text": "End navigation When you reach your destination, navigation will automatically end. Select “Done” to return to the current location display. If you want to end navigation before reaching your destination, press ▼ on the 4- way key switch to open the navigation menu and select “End Navigation”. ➢ You can also mute or unmute directions. ➢ If you select \"Skip Waypoint\", the nearest waypoint is skipped. Audio You can listen to the music via your smartphone. Pressing ✓ switch start and stop playing music. Press ▶ on the 4-way key switch to play next music. Press ◀ on the 4-way key", "provenance": {"document_id": "honda_activa_e_roadsync_duo_manual", "url": "https://edge.sitecorecloud.io/hondamotorc388f-hmsi8ece-prodb777-e813/media/Project/HONDA2WI/honda2wheelersindia/pdf/EV/ACTIVA-e/2025/February-Roadsync/activa-e-roadsync-duo-manual.pdf", "source_type": "official", "document_type": "connectivity_manual", "manufacturer": "Honda Motorcycle and Scooter India", "vehicle_model": null, "retrieved_at": "2026-11-22T15:25:22.418285+00:00"}, "metadata": {"category": null, "group": null, "page": 9}}
