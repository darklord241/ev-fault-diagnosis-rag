# =====================================================================
# AI-Assisted Fault Diagnosis - Agent Orchestrator & MCP Configuration
# =====================================================================

# --- LLM Provider Settings ---
# Primary provider: "gemini" | "openai" | "anthropic" | "ollama" | "groq"
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.2

# API Keys (Set the one for your active provider)
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- MCP Server Configuration ---
# Transport type: "sse" or "stdio"
MCP_TRANSPORT=sse
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001
MCP_SSE_ENDPOINT=http://127.0.0.1:8001/sse

# --- Backend Hybrid Retrieval API (Teammate's Component) ---
# If true, uses built-in realistic EV domain mock data when backend API is offline
HYBRID_RETRIEVAL_USE_MOCK=true
HYBRID_RETRIEVAL_API_BASE_URL=http://127.0.0.1:8000/api/v1/retrieval
HYBRID_RETRIEVAL_API_KEY=

# --- Orchestrator API (Dashboard Gateway) ---
ORCHESTRATOR_API_HOST=0.0.0.0
ORCHESTRATOR_API_PORT=8080
DIAGNOSIS_DB_PATH=data/diagnosis_history.sqlite3
LOG_LEVEL=INFO
