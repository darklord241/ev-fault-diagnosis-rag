# Retrieval API shared secret. Set the same value as
# HYBRID_RETRIEVAL_API_KEY in the orchestrator's .env file.
BACKEND_API_KEY=replace-with-a-long-random-local-secret

# Paths are relative to the repository root when running uvicorn from there.
EV_CHUNKED_DIR=scraper/data/chunked
EV_EMBEDDING_CACHE_PATH=scraper/data/embeddings/chunk_vectors.json

# The diagnosis API gateway forwards requests to the agent orchestrator.
AGENT_ORCHESTRATOR_BASE_URL=http://127.0.0.1:8080
